# Copy to .env (never committed). Every value stays on the server; only PAYPAL_CLIENT_ID may reach a browser.

# PayPal: developer dashboard → Apps & Credentials → Sandbox tab → app linked to a US sandbox business account
PAYPAL_ENV=sandbox                 # the app refuses to start on anything else
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # printed by scripts/paypal/create-webhook.mjs, for verify-webhook-signature

# Database (Render Postgres 0.1c-256mb, paid; never Render free, it expires mid-judging)
DATABASE_URL=

# Render: Account settings → API Keys. Local only, for deploy status and logs; never set on the service
RENDER_API_KEY=
RENDER_WORKFLOW=ringside-close-out # slug of the close-out workflow service; inline close-out unless the key is also set
RENDER_WORKFLOW_API_KEY=           # a separate Render API key, set on the web service, only to start close-out runs

# ElevenLabs Agents
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_SECRET=            # shared secret the agent's server tools send in a header
ELEVENLABS_AGENT_LLM=              # optional: the agent's model (default gpt-6-luna)
ELEVENLABS_AGENT_REASONING=        # optional: its reasoning effort (default low)

# Email: the PayPal link for phone callers (Resend, free to 3,000/month; sending domain verified on Cloudflare DNS)
RESEND_API_KEY=
EMAIL_FROM="Mike's Plumbing <bookings@ringside.padmanabhan.xyz>"

# Twilio (upgraded account; the number is imported into ElevenLabs, which holds these too)
TWILIO_PHONE_NUMBER=               # E.164; the number shown on the site is in src/lib/business.ts
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TEST_CALLER_ID=             # owner's mobile, verified in Twilio; only the From of test calls (a number can't call itself)
TWILIO_AUTH_TOKEN=                 # Console home → Account Info; only for importing the number into ElevenLabs, which checks
                                   # Twilio's webhook signatures with it. Never set on Render

# Change-order parser model (provider decided in docs/decisions.md)
LLM_API_KEY=
LLM_MODEL=

# Voice cost caps live on the ElevenLabs agent itself (40 calls a day, 2 at once, 6-minute calls)

# Web push: notifications on Mike's installed dashboard. node scripts/push/vapid.mjs writes all three; push is off without them
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:padmanabhan.rajendrakumar@gmail.com

APP_BASE_URL=

# Mike's Books (AG Studio)
AG_STUDIO_LICENSE_KEY=             # AG Studio trial or licence key; public (it reaches the browser)
BOOKS_LLM_MODEL=                   # optional: Ask your books' model (default claude-haiku-5-5)
MATCH_LLM_MODEL=                   # optional: Book without calling's problem matcher (default claude-haiku-5-5)
